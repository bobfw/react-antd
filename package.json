{
  "name": "react-antd",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#util": "./src/util/index.ts",
    "#comm": "./src/comm/index.ts",
    "#components": "./src/components/index.ts"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "lint": "oxlint .",
    "check": "pnpm run format && tsc -b tsconfig.app.json && pnpm run lint",
    "gc-open-api": "openapi-typescript https://raw.githubusercontent.com/sebastienlevert/jsonplaceholder-api/refs/heads/main/openapi.yaml -o ./src/comm/openapi/schema.d.ts",
    "prepare": "husky",
    "release": "sh scripts/release.sh"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "^3.1.12-0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "antd": "^6.6.6",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "immer": "^11.1.21",
    "jotai": "^3.0.1",
    "jotai-immer": "^0.4.3",
    "openapi-fetch": "^0.17.0",
    "overlay-kit": "^1.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.45",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/devtools": "^0.7.6",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
